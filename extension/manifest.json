{
  "manifest_version": 3,
  "name": "ExtNest",
  "short_name": "ExtNest",
  "version": "0.3.1",
  "description": "Gerenciador privado de extensões com GitHub, AppData e backup de configurações em OneDrive/Google Drive.",
  "key": "",
  "permissions": [
    "management",
    "nativeMessaging",
    "storage",
    "alarms",
    "notifications",
    "identity"
  ],
  "action": {
    "default_title": "Abrir ExtNest",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "ids": [
      "*"
    ]
  }
}
