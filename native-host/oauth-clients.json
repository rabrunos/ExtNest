{
  "schema": 2,
  "github": {
    "type": "github_app",
    "client_id": "SET_GITHUB_APP_CLIENT_ID",
    "app_slug": "SET_GITHUB_APP_SLUG"
  },
  "microsoft": {
    "client_id": "SET_MICROSOFT_ENTRA_CLIENT_ID",
    "tenant": "common",
    "scopes": [
      "offline_access",
      "openid",
      "profile",
      "User.Read",
      "Files.ReadWrite.AppFolder"
    ]
  },
  "google": {
    "client_id": "SET_GOOGLE_DESKTOP_CLIENT_ID",
    "scopes": [
      "openid",
      "email",
      "profile",
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  }
}
